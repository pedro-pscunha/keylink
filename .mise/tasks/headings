#!/usr/bin/env python3
"""A doc heading is one line, and a heading that wraps loses its second half.

`# ` in a doc comment is an ATX heading, and CommonMark ends an ATX heading at
the newline. So a heading written across two `///` lines renders as a heading
holding the first half and a PARAGRAPH holding the second, directly under it.
The sentence a reader sees is truncated at whatever word the author happened to
wrap at, and the remainder reads as the section's opening line.

**Nothing else in this repository can see it.** It is valid markdown, so
`-D warnings` has nothing to warn about: `mise run docs` renders the truncated
heading and exits 0. `--document-private-items` does not help — it documents more
items, and rustdoc has no lint saying a heading is short. And one of the six this
check was written against lives in
`keylink/tests/supervision.rs`, which `mise run docs` NEVER hands to rustdoc —
so for that site a grep is not a cheap substitute for the real instrument, it is
the only instrument there is.

── the one thing that makes this check honest, and it is measured

A rustdoc hidden doctest line is also `# `, and there are eight of them here, two
per file in `keylink-persist/src/{file.rs,lib.rs,versioned.rs}` and
`keylink/src/persist.rs`. Each pair is **a hidden function opener and its closing
brace** — `# async fn run() -> Result<..>` twice, `# fn restore(..)`, `# async fn
bump<C: Claim>(..)`, and `# }` four times — inside a fence, wrapping an example so
the visible lines read as the body. They are not headings at all. Without fence
tracking this check reports FOURTEEN sites and eight of them are correct code.
With it, six.

**This paragraph called them "`# use ..;` lines" until the merge gate read them.**
Not one of the eight is a `use`. The count of eight and the four files were right,
which is what let the wrong noun sit inside a sentence arguing the measurement had
been done twice — a number can be checked by re-running a command, and a noun
cannot. Whoever edits this next: open the eight lines.

The rule is deliberately narrow: a heading line whose NEXT line is doc prose.
A heading followed by a blank `///` is the convention everywhere in this tree,
so the narrow rule needs no allowlist — it found six sites and zero false
positives across every tracked `.rs` file.
"""

import pathlib
import re
import subprocess
import sys

# `# ` through `###### `, needing the space and something after it. `#[derive..`
# in a fenced example has no space and is not a heading; the space is what keeps
# an attribute out.
HEADING = re.compile(r"^\s*//[/!]\s+#{1,6}\s+\S")
DOC_LINE = re.compile(r"^\s*//[/!](.*)$")
# CommonMark accepts either marker for a fenced block, and pulldown-cmark — the
# parser rustdoc uses — accepts both. Matching only ``` made a `~~~` example's
# hidden `# ` lines read as headings, which is a false positive nobody had written
# yet. The docstring above claims zero false positives, so the claim and the
# pattern have to agree.
FENCE = re.compile(r"^(```|~~~)")


def wrapped_headings(path: pathlib.Path) -> tuple[list[tuple[int, str]], int | None]:
    """Wrapped headings in `path`, and the line where an unclosed fence opened.

    **The second return value exists because its absence was a silent hole.** A
    doc comment that opens a fence and never closes it left `fenced` true for
    every later line in the file, so this check skipped all of them AND still
    reported `ok`. A checker that goes quiet on malformed input reports the
    absence of what it stopped looking for. The caller refuses instead.
    """
    lines = path.read_text().split("\n")
    found = []
    fenced_at: int | None = None
    for i, line in enumerate(lines):
        doc = DOC_LINE.match(line)
        if doc and FENCE.match(doc.group(1).strip()):
            fenced_at = None if fenced_at is not None else i + 1
            continue
        if fenced_at is not None or not HEADING.match(line):
            continue
        following = DOC_LINE.match(lines[i + 1]) if i + 1 < len(lines) else None
        if following is None:
            continue
        rest = following.group(1).strip()
        # A blank `///` ends the heading, and so does a second heading. Anything
        # else on the next line is the half of this heading that never renders.
        if rest and not rest.startswith("#"):
            found.append((i + 1, line.strip()))
    return found, fenced_at


def main() -> int:
    tracked = subprocess.run(
        ["git", "ls-files", "*.rs"], capture_output=True, text=True, check=True
    ).stdout.split()
    wrapped: list[tuple[str, int, str]] = []
    unclosed: list[tuple[str, int]] = []
    for f in tracked:
        found, fenced_at = wrapped_headings(pathlib.Path(f))
        wrapped.extend((f, n, text) for n, text in found)
        if fenced_at is not None:
            unclosed.append((f, fenced_at))

    # Refused BEFORE the wrapped-heading verdict, because an unclosed fence means
    # this run stopped inspecting that file partway and cannot speak for the rest
    # of it. Reporting `ok` here would be reporting on lines nobody read.
    if unclosed:
        print("FAIL: a doc comment opens a code fence and never closes it, so every")
        print("      later line in that file was SKIPPED by this check. Close it.")
        print()
        for f, n in unclosed:
            print(f"  {f}:{n}  fence opened here, still open at end of file")
        return 1

    if wrapped:
        print("FAIL: a doc heading wraps, so everything after the wrap renders as")
        print("      a paragraph under a truncated heading. Join it onto one line.")
        print()
        for f, n, text in wrapped:
            print(f"  {f}:{n}")
            print(f"      {text}")
        return 1
    print(f"ok: no doc heading wraps, across {len(tracked)} tracked .rs files")
    return 0


if __name__ == "__main__":
    sys.exit(main())
