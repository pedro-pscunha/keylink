#!/usr/bin/env python3
"""Every copy of the `pre-commit` task list agrees with `mise.toml`.

MISE description="Every copy of the pre-commit task list agrees with mise.toml"
"""
# `mise.toml` defines `pre-commit` once, and THREE other files restate it. Two of
# them were wrong when this task was written, and the third had been wrong twice:
#
#   * `.githooks/pre-commit` INVOKES the tasks itself when `mise` is absent, so a
#     missing line there is a commit gated by fewer checks than the hook claims.
#     It has been one task short twice.
#   * `CONTRIBUTING.md` and `scripts/install-hooks.sh` DESCRIBE the list. Both said
#     "fmt, clippy on the library" while the list ran five tasks, so `framing`,
#     `anchors` and `anchors-selftest` were invisible in both places a contributor
#     looks first.
#
# `.githooks/pre-commit` predicted the recurrence in its own comment — "THIS LIST
# IS HAND-MAINTAINED AND WILL DRIFT AGAIN ... nothing enforces that" — and that
# sentence is the reason this file exists rather than a fourth repair of the
# strings. A prediction of drift with no check behind it is a note, not a guard.
#
# ── WHY THIS IS A TASK AND NOT A ROW IN `mise run hook-guard` ─────────────────
#
# `hook-guard` is the harness for hook BEHAVIOUR, and it is deliberately in none
# of `gate`, `pre-commit` or `pre-push`, because it commits and pushes. A drift
# check that lived there would run only when somebody remembered to run it — and
# "nothing enforces that" is the exact defect being closed. This check reads text
# and executes nothing, so it has no recursion hazard and can sit in the lists
# themselves. It is in BOTH `gate` and `pre-commit`, following
# `anchors-selftest`: a guard that does not run where the thing it guards runs is
# a guard on paper.
#
# ── WHAT IT CHECKS, AND THE TAUTOLOGY IT AVOIDS ───────────────────────────────
#
# The obvious version searches each file for each task NAME, and it is worthless
# for the two prose copies: `CONTRIBUTING.md` mentions `framing`, `anchors` and
# `fmt-check` in several unrelated paragraphs, so every name is present whatever
# the copy says. That is `anchors`' own record-quote defect one file over — a
# check satisfied by text that is not the text under test.
#
# So each copy is ANCHORED to the one region that is the copy, and each anchor is
# required to occur EXACTLY ONCE. An anchor that moves gives count 0 and fails
# loudly, which is the direction to be wrong in.
#
# Both directions, for the invoking copy: every task in the list must be invoked,
# AND every command in the fallback must be a task in the list. One direction
# alone leaves a stale leftover invisible.
#
# ── AND WHAT IT DOES NOT CHECK ────────────────────────────────────────────────
#
# `gate`, which is a different and longer list with its own copies in `README.md`.
# Nothing here says a word about those. This closes the `pre-commit` list because
# that is the list with three copies and a measured history of drifting.
#
# It also never RUNS the fallback. It compares text; whether the hook then behaves
# is `mise run hook-guard`'s question.
#
# ── MADE RED, EVERY BREAK RUN AND WATCHED, EACH NAMING THE ROWS IT REDDENS ─────
#
# Perturbed on a COPY: the four files this task reads, plus `.mise/tasks/`, copied
# into a `git init`-ed temp directory. The task resolves its root from the cwd
# rather than from its own path, so the copy reads the copy, and the tree is never
# written to.
#
# **A TRAP FOR WHOEVER REPLAYS THESE, MEASURED THE HARD WAY.** `python3` on this
# developer's PATH is a mise SHIM, and a shim loads mise config from the cwd — so
# an UNTRUSTED `mise.toml` in the temp directory makes the interpreter exit 1
# before this file runs a single line. Five breaks were recorded as caught before
# the control run was tried and came back red too. Export
# `MISE_TRUSTED_CONFIG_PATHS=<the copy>`, and always run the unperturbed control
# first: an exit code means nothing until you have seen it be 0.
#
# T1. **Drop an invocation.** In `.githooks/pre-commit`, replace the two adjacent
#     lines invoking `anchors-selftest` and then this task with the first of them
#     alone. Watched:
#
#         FAIL the mise-absent fallback runs `task-lists`
#
#     **The pair is the search literal because the single line is NOT unique, and
#     this record's own subject made it so.** The first version of this break
#     searched for the bare invocation path, and the paragraph above — the one
#     naming the file that closes the drift — put a second copy of that path into
#     the same hook, as a backticked span. `break-once.sh` aborted with `the search
#     literal occurs 2 times`, which is `.mise/tasks/anchors`' documented same-file
#     trap arriving through the comment that documents the fix for it. Two adjacent
#     whole lines are unique where one is not.
#
# T2. **Swap two invocations.** Exchange the `.mise/tasks/anchors` and
#     `.mise/tasks/anchors-selftest` lines. Watched:
#
#         FAIL the fallback runs the tasks in mise.toml's order
#
# T3. **Leave a command behind.** Add `cargo test --doc` under
#     `cargo fmt --all -- --check`. Watched:
#
#         FAIL the fallback runs NOTHING that is not in the list
#
# T4. **Drift an inlined command.** Change `cargo fmt --all -- --check` to
#     `cargo fmt --all`. Watched — TWO rows, because a drifted line is both a
#     missing invocation and an unexplained one, and the pair says so:
#
#         FAIL the mise-absent fallback runs `fmt-check`
#         FAIL the fallback runs NOTHING that is not in the list
#
# T5. **Move the anchor.** Replace the `note: 'mise' is not installed` line with
#     any other text. Watched:
#
#         FAIL the fallback block in .githooks/pre-commit is findable
#
# T6. **THE PREFIX COLLISION, and this break is why the checker was rewritten.**
#     Delete ONLY the `.mise/tasks/anchors` line, leaving
#     `.mise/tasks/anchors-selftest`. Watched:
#
#         FAIL the mise-absent fallback runs `anchors`
#
#     Under the first version of this file it printed `ok:` instead. `find` matched
#     the selftest line, so a MISSING task read as present — the one direction this
#     task exists to catch, in the task built to catch it. T2 was green for the same
#     reason. Both went red once the comparison moved to whole lines.
#
# T7. **Drop a name from the prose.** Remove `framing, ` from `CONTRIBUTING.md`'s
#     `mise run pre-commit` row. Watched:
#
#         FAIL CONTRIBUTING.md names every task in the list
#
# T8. **Drop a name from the installer.** Remove `task-lists, ` from
#     `scripts/install-hooks.sh`'s `pre-commit` line. Watched:
#
#         FAIL scripts/install-hooks.sh names every task in the list
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
)

MANIFEST = ROOT / "mise.toml"
manifest = MANIFEST.read_text()
failures: list[str] = []


def fail(what: str, *detail: str) -> None:
    failures.append(what)
    print(f"FAIL {what}", file=sys.stderr)
    for line in detail:
        print(f"       {line}", file=sys.stderr)
    print(file=sys.stderr)


def block(name: str) -> str:
    """The body of `[tasks.<name>]`, up to the next table header."""
    at = manifest.find(f"[tasks.{name}]")
    if at < 0:
        sys.exit(f"task-lists: mise.toml has no [tasks.{name}] - this checker is lost")
    rest = manifest[at + 1 :]
    end = rest.find("\n[")
    return rest if end < 0 else rest[:end]


# ── the source of truth ───────────────────────────────────────────────────────
#
# Parsed with `re` rather than `tomllib`, because the three scripts in this list
# run standalone when `mise` is absent, and the python3 that is then on PATH is
# whatever the machine ships. `tomllib` arrived in 3.11. `anchors` and
# `anchors-selftest` are stdlib-only for the same reason.
ORDER = re.findall(r'\{\s*task\s*=\s*"([^"]+)"\s*\}', block("pre-commit"))
if not ORDER:
    sys.exit("task-lists: could not read [tasks.pre-commit]'s run list from mise.toml")


def invocation(task: str) -> str:
    """What `.githooks/pre-commit` has to contain in order to run `task` itself.

    A FILE task under `.mise/tasks/` is invoked by path. Anything else is a
    `mise.toml` task, and the fallback has to inline its command — so the command
    is read from the manifest rather than copied here, which is what makes a
    DRIFTED inline command a failure and not just a missing one.
    """
    if (ROOT / ".mise" / "tasks" / task).exists():
        return f".mise/tasks/{task}"
    run = re.search(r'^run = "([^"]+)"$', block(task), re.M)
    if run is None:
        sys.exit(
            f"task-lists: [tasks.{task}]'s `run` is not a single quoted command, so "
            "this checker cannot say what the fallback must contain. Teach it, or "
            "keep that task out of `pre-commit`."
        )
    return run.group(1)


# ── copy 1: the hook INVOKES them ─────────────────────────────────────────────
HOOK = ROOT / ".githooks" / "pre-commit"
hook = HOOK.read_text()
NOTE = "echo \"note: 'mise' is not installed - running the same checks directly\" >&2"
if hook.count(NOTE) != 1:
    fail(
        "the fallback block in .githooks/pre-commit is findable",
        f"looked for exactly one line reading: {NOTE}",
        f"found {hook.count(NOTE)}. The anchor moved, or the fallback is gone.",
    )
else:
    # ── WHOLE LINES, and a substring match here was a FALSE GREEN ──────────────
    #
    # The first version asked `fallback.find(want)`, and `.mise/tasks/anchors` is
    # a PREFIX of `.mise/tasks/anchors-selftest`. So deleting the `anchors` line
    # left `find` matching the selftest line, and the checker reported a task as
    # invoked that the hook no longer ran — a missing task looking present, which
    # is the one direction this file exists to catch. The order probe had the same
    # hole and stayed green on a swap of exactly that pair.
    #
    # Measured, not reasoned: with the substring form, swapping those two lines
    # passed. Comparing whole lines closes both at once, and it is the remedy
    # `.mise/tasks/anchors` writes down for its own rot mode 4.
    fallback = hook.split(NOTE, 1)[1]
    expected = [invocation(task) for task in ORDER]
    ran = [
        line.strip()
        for line in fallback.splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    for task, want in zip(ORDER, expected):
        if want not in ran:
            fail(
                f"the mise-absent fallback runs `{task}`",
                f"`.githooks/pre-commit` has no line reading: {want}",
                "mise.toml's `pre-commit` list is the authority. That hook runs the",
                "checks itself when mise is missing, so a line missing here is a",
                "commit gated by less than the hook says it gates.",
            )
    if all(want in ran for want in expected):
        order = [ran.index(want) for want in expected]
        if order != sorted(order):
            fail(
                "the fallback runs the tasks in mise.toml's order",
                "every task is invoked, but not in the order the manifest lists them.",
                "The order decides which failure a contributor sees first.",
            )
    # The other direction. A command left behind after a task is removed from the
    # list runs on every commit while nothing claims it should.
    for line in ran:
        if line not in expected:
            fail(
                "the fallback runs NOTHING that is not in the list",
                f"`.githooks/pre-commit` runs: {line}",
                "which is not any task in mise.toml's `pre-commit` list. Either add",
                "the task to the manifest or drop the line.",
            )

# ── copies 2 and 3: they DESCRIBE the list ────────────────────────────────────
#
# Each anchored to its single line, so an unrelated paragraph naming a task
# cannot satisfy the check.
DESCRIBED = [
    ("CONTRIBUTING.md", r"^\| `mise run pre-commit` \|.*$"),
    ("scripts/install-hooks.sh", r'^echo "  pre-commit .*$'),
]
for relative, pattern in DESCRIBED:
    text = (ROOT / relative).read_text()
    found = re.findall(pattern, text, re.M)
    if len(found) != 1:
        fail(
            f"the pre-commit description in {relative} is findable",
            f"expected exactly one line matching: {pattern}",
            f"found {len(found)}. Re-anchor this row, or restore the line.",
        )
        continue
    line = found[0]
    missing = [task for task in ORDER if task not in line]
    if missing:
        fail(
            f"{relative} names every task in the list",
            f"the line does not name: {', '.join(missing)}",
            f"the line reads: {line.strip()}",
            "It is read before anybody runs the hook, so a task it omits is a check",
            "a contributor does not know runs.",
        )

if failures:
    print(f"{len(failures)} copy of the pre-commit list disagrees with mise.toml"
          if len(failures) == 1
          else f"{len(failures)} checks failed against mise.toml's pre-commit list",
          file=sys.stderr)
    sys.exit(1)
print(f"ok: every copy of the pre-commit list agrees with mise.toml "
      f"({', '.join(ORDER)})")
