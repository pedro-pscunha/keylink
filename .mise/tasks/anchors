    `.rs` file - measured, by making that exact cut. A seam a probe can drive is the
    difference between the policy being checked here and being checked nowhere.
    """
    if text is None:
        text = (ROOT / path).read_text()
    blocks = comment_blocks(text, markers_for(path, text))
    return set().union(*(spans(b) for b in blocks))


