# Removing `markers_for` from `quoted_spans` then left this task printing output
# byte-identical to the green run at exit 0 - the probe was green because it had
# reimplemented the plumbing it was meant to check. Driving the real function is what
# makes that cut red.
#
# **TWO probes, because `markers_for` has two clauses and a `.sh` path reaches only
# one.** The suffix clause is what `scripts/hook-guard.sh` needs and the shebang clause
# is what `.githooks/pre-push` needs, since it has no suffix to key on. One probe would
# leave the clause written for the second of those two files unexercised - which is
# this same defect, one clause smaller.
PROBES = (
    ("probe.sh", "set -eu\n# replacing `expected_len=64` with 40.\n"),
    ("hooks/probe", "#!/usr/bin/env bash\n# replacing `expected_len=64` with 40.\n"),
)
for probe_path, probe_text in PROBES:
    # The DECISION is `quoted_spans`, and these two are the DIAGNOSTIC only - the halves
    # of the answer, printed so a failure says which half went wrong. They deliberately
    # recompute what `quoted_spans` does internally, and that is the point: when the two
    # agree and the haystack is still empty, the caller is what dropped the markers.
    probe_markers = markers_for(probe_path, probe_text)
    probe_blocks = comment_blocks(probe_text, probe_markers)
    if flat("expected_len=64") in quoted_spans(probe_path, probe_text):
        continue
    bad += 1
    print("FAIL reader: the `#` marker arm finds no backticked span in a "
          "`#`-commented record", file=sys.stderr)
    print(f"       probe path:     {probe_path}", file=sys.stderr)
    print(f"       markers chosen: {probe_markers}", file=sys.stderr)
    print(f"       blocks read:    {probe_blocks}", file=sys.stderr)
    print("       Every registered row lives in a .rs file, so the tree cannot",
          file=sys.stderr)
    print("       redden this. Without the arm, `quoted_spans` hands back an EMPTY",
          file=sys.stderr)
    print("       haystack for a shell file, and every row registered against one",
          file=sys.stderr)
    print("       is reported as quoted by NOBODY - a record accused of a defect a",
          file=sys.stderr)
    print("       reader can see is absent. Fix the reader, never the record.",
          file=sys.stderr)
    print("       The two lines above split the fault: wrong markers mean",
          file=sys.stderr)
    print("       `markers_for` picked the wrong set, while RIGHT markers over a",
          file=sys.stderr)
    print("       block that HOLDS the span mean `quoted_spans` did not pass them on.",
          file=sys.stderr)
    print(file=sys.stderr)

for record, lives_in, target, literal in ANCHORS:
    if lives_in not in spancache:
        spancache[lives_in] = quoted_spans(lives_in)
    if flat(literal) in spancache[lives_in]:
        continue
    bad += 1
    print(f"FAIL {record}: this task's literal is NOT QUOTED by its own record",
          file=sys.stderr)
    print(f"       record lives in: {lives_in}", file=sys.stderr)
    print(f"       task's literal:  {literal}", file=sys.stderr)
    print("       Looked for it as a `backticked` span inside a COMMENT of that",
          file=sys.stderr)
    print("       file, compared whole rather than as a substring - so neither the",
          file=sys.stderr)
    print("       code line nor a longer quote containing it will satisfy this.",
          file=sys.stderr)
    print("       The record was re-quoted and this list was not, or the row names",
          file=sys.stderr)
    print("       the wrong record. The RECORD is the source of truth; follow it.",
          file=sys.stderr)
    print(file=sys.stderr)

# ── a re-quoted record must LEAVE `DESCRIBED` ─────────────────────────────────
#
# The one thing about that list which is checkable, and its own header says why it
# is worth checking: without the list, a record absent from `ANCHORS` is ambiguous,
# and the ambiguity favours the wrong reading - somebody re-quotes an anchor that
# was converted on purpose, the new row LOOKS like coverage, and the stale entry
# goes on asserting that quoting was measured to be impossible.
#
# **This is NOT the check that header rules out.** That one - "the retired literal
# no longer appears in the record's file" - cannot work, because a record explaining
# why it was converted quotes the retired literal to do so, and an explanatory quote
# is textually identical to a search quote. This check reads no file at all: it
# compares two lists of ids, so the objection does not reach it.
#
# What it cannot do is notice a record re-quoted and registered NOWHERE. Nothing in
# this file can - registration is opt-in per record, which the header states.
row_ids = {record for record, _, _, _ in ANCHORS}
for record in sorted(row_ids & {record for record, _, _, _ in DESCRIBED}):
    bad += 1
    print(f"FAIL {record}: registered in ANCHORS and listed in DESCRIBED at once",
          file=sys.stderr)
    print("       Those two rows say opposite things about one record: that its",
          file=sys.stderr)
    print("       search literal is quoted and checked, and that quoting it was",
          file=sys.stderr)
    print("       MEASURED to be impossible. If the record quotes an anchor now,",
          file=sys.stderr)
    print("       the ANCHORS row is the live one - drop the DESCRIBED entry.",
          file=sys.stderr)
    print(file=sys.stderr)

# ── a REDNESS entry must name a row that exists ───────────────────────────────
#
# `mise run replay-anchors` takes the target and the search literal from `ANCHORS`
# and everything else from `REDNESS`, so an entry naming no row is a replay that
# cannot run. Without this it would be found by running the replayer, which no gate
# does - so the entry would sit there reading like coverage.
#
# The reverse is NOT checked, deliberately: a row with no `REDNESS` entry is the
# normal case. That list samples, and its header says which rows it leaves out.
for record in sorted(set(REDNESS) - row_ids):
    bad += 1
    print(f"FAIL {record}: has a REDNESS entry and no ANCHORS row", file=sys.stderr)
    print("       The replayer reads the file and the search literal from ANCHORS,",
          file=sys.stderr)
    print("       so this entry has nothing to cut. Either the row was dropped and",
          file=sys.stderr)
    print("       this entry outlived it, or the id is misspelled.", file=sys.stderr)
    print(file=sys.stderr)

# ── population tripwire ───────────────────────────────────────────────────────
#
# A count, deliberately, and the safe kind: it can only fail LOUDLY. There is no
# state in which it passes while wrong, which is what separates it from the
# whole-target pass/fail counts this convention retired. The rule is not "never
# write a count" - it is "never write a count that can pass while wrong".
#
# What it buys: ADDING a break record forces a decision about registering it,
# instead of this list silently falling further behind a growing population.
#
# ── THE METHOD, because this number now fails the build when it moves ─────────
#
# A reviewer measured 86 where this says 98. Both are right for their own
# definitions, and neither is written down anywhere - so a contributor who trips
# this, re-measures by a different reasonable definition and gets a third number
# cannot tell which one the constant meant. It counts:
#
#   * both crates - `keylink/**/*.rs` AND `keylink-persist/**/*.rs` - PLUS
#     `scripts/*.sh` and every file directly under `.githooks/`, because those hold
#     registered records too. NOT `.mise/tasks/*`, because no row lives there;
#   * contiguous runs of comment lines joined into one block, with the marker chosen
#     PER FILE by `markers_for`: `///`, `//!` or plain `//` in Rust, so a `//` line
#     adjacent to a `///` run merges into it, and `#` in shell;
#   * blocks whose joined text contains the string `break-once.sh`.
#
# **The second bullet used to say only the three Rust markers, and the first only the
# two crates. Both were true of a narrower walk and were left behind by this one** -
# which is the shape to watch for here: the loop moved and the paragraph describing it
# did not, so the number stopped being reproducible from its own stated method.
#
# Change any of those three and the number changes. The loop below IS the
# definition; this comment exists so the number can be reproduced without
# reading it.
#
# ── AND IT IS BLIND TO PART OF THE POPULATION, DERIVED ON EVERY RUN ───────────
#
# One marker, and records use three. A record phrased "Made red by .." without
# naming the harness does not move this constant at all, and the tripwire stays
# green. **The size of that blind spot is now COMPUTED by the walk below and
# PRINTED by the success summary** - `HARNESS` plus `UNNAMED` is the widened
# definition, and the blind figure is the difference between the widened population
# and the counted one, both measured by one loop on one tree.
#
# ── it was three hand-written figures, and they went stale three times ────────
#
# Always in the same direction, and that is why the derivation is worth the lines:
# this paragraph exists to BOUND what the tripwire cannot see, so understating the
# bound is the one error that matters here.
#
#   * `144 / 98 / 46` was written before its branch rebased onto `call-id`. The
#     rebase moved the tree under it, and the declared blind spot was nine blocks
#     short of the tree it was read against.
#   * `157 / 102 / 55` went stale INSIDE ONE COMMIT, past the one mitigation this
#     convention had. Its date was ALREADY 2026-08-08 when it went wrong, so no
#     reader could order the snapshot against the commit that broke it: a same-day
#     figure is unfalsifiable by date alone. A date is a tiebreaker between two
#     snapshots and never evidence that either is current.
#   * `158 / 103 / 55` was the last hand-written triple, and it carried a paragraph
#     arguing that its blind figure had held steady. Re-measured 2026-08-08 (-03:00)
#     by that same walk and those same three markers, **all three had moved, and the
#     difference had moved with them** - which is the shape a subtraction hides,
#     because two inputs moving together leave the result looking derived. The
#     replacement values are deliberately absent from this list: writing them here
#     would be the fourth triple that the paragraph below refuses, above the sentence
#     refusing it, and any branch adding a record block moves two of the three while
#     this comment cannot. The success summary prints all three off one walk.
#
# The dates carry a UTC offset because a bare date cannot be ordered against
# another bare date from a different zone, and "which of these two figures is
# older" is exactly the question a stale one makes somebody ask.
#
# **So the fix is not a fourth triple.** A figure describing the whole tree cannot
# be kept true by care, by a date, or by a warning paragraph - a sibling branch or a
# rebase moves the tree under it, and it then reads as current. `RECORD_BLOCKS` is
# the shape that survives that: it FAILS LOUDLY the moment it disagrees with its own
# tree. A figure that only informs has no such state, so it is derived instead of
# declared.
#
# The tripwire itself is NOT widened, deliberately: the value it has is LOUDNESS ON
# CHANGE rather than completeness, and widening it would move the constant again
# while still leaving some other phrasing outside. Green here means the
# `break-once.sh` population is unchanged, and it is not a statement about every
# break record.
# ── the number, and what moved it last ────────────────────────────────────────
#
# 98 -> 102 when `call-id` merged (PR #11), which added four records mentioning
# the harness. **The tripwire fired and this is the decision it forced**, recorded
# rather than absorbed: those records carry quoted anchors that belong in ANCHORS
# above, and they are NOT registered here yet. Registration is tracked as its own
# task, because a candidate's SEARCH literal cannot be told from its watched output
# or its replacement mechanically - the sweep over those files returns roughly
# forty spans for ten anchors - so it needs the authoring branch's own list to
# cross-check against, and one list read twice is not a cross-check.
#
# Bumping the number without registering them is the one move this comment exists
# to make visible. Green here now means "the population is 102", not "102 records
# are checked". The ratio is not written here on purpose - a copy of it would go
# stale on the next row added. The success line COMPUTES it instead.
#
# ── A PROPERTY OF THIS CONSTANT THAT COSTS A BISECT, MEASURED ON THIS BRANCH ───
#
# **A constant measuring the WHOLE TREE is invalidated wholesale by a rebase, at
# every commit still carrying the old value.** Six commits on this branch declare 98
