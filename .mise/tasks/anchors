    ("P1", "keylink/tests/defer.rs", "keylink/src/actor/remote.rs",
     "    drop(route);"),
    ("P2", "keylink/tests/defer.rs", "keylink/src/actor/remote.rs",
     "    drop(route);"),
]

# Records whose search edit is DESCRIBED, deliberately, and must stay that way.
#
# **What a row here MEANS, and it is narrower than it looks: this record once had a
# quoted search literal, somebody removed it on purpose, and here is why.** It does
# NOT mean "has no quoted literal" - most records in this repo have none and were
# never converted, and they do not belong here.
#
# That distinction has to hold before the population ever gets classified in bulk.
# A migration that swept every unquoted record into this list would make every row
# assert a deliberateness nobody checked - which is this convention's own failure
# mode arriving through the fix for it. If a standing category is wanted for records
# **born** without a quote, it needs its own name and its own list; provenance may
# not matter to a reader, but the deliberateness does.
#
# **This is documentation and NOT a check, and the reason is worth stating because
# it looks checkable and is not.** The obvious assertion — "the retired literal no
# longer appears in the record's file" — fails immediately: a record that explains
# *why* it was converted quotes the retired literal to do so, and an explanatory
# quote is textually identical to a search quote. Measured, not assumed: R26a's file
# contains its retired anchor exactly once, and that once is the paragraph
# documenting the rot mode. Any rule strong enough to catch a re-quote would flag
# that paragraph, and any rule loose enough to permit it catches nothing.
#
# What the list is for, then: **distinguishing "deliberately described" from
# "forgotten".** Without it a record absent from ANCHORS is ambiguous, and the
# ambiguity favours the wrong reading — somebody re-quotes an anchor that was
# converted on purpose, reinstating the rot the conversion removed, and the new
# entry looks like coverage.
# ── A ROW HERE MUST CARRY ITS MEASURED COUNT AND THE TREE IT WAS MEASURED AT ───
#
# **State the measurement that made quoting impossible, not the property that made
# it look impossible.** Six rows were once here. FIVE of them gave a property, every
# property was true, and not one of the five conclusions survived a count:
#
#   * "the record is in the file its break edits, so a quote is a second occurrence"
#     - true of the BARE form, false of the indented one. Three rows, R11, R19, C11;
#   * "a fragment cannot be disambiguated by indentation" - true, and mode 4's remedy
#     is to stop quoting the fragment. C12;
#   * "the site spans three lines, so no anchor exists" - true of the SITE, false of
#     the ANCHOR, because a one-line search may have a multi-line replacement. C14;
#   * "a reflow will rot this anchor" - true, and a reflow gives count 0, which is
#     LOUD, so it argues for quoting. C13.
#
# The reason a reason rots here is that **a reason for NOT doing something is never
# exercised.** A quoted anchor is re-checked on every commit; a description is read,
# found plausible, and left. So this list accumulates arguments that were sound once,
# each keeping a true-sounding first clause. A count with a tree can be falsified in
# one command; a property has to be re-derived, and re-derivation is how a correct
# row acquires a false reason.
#
# Where a remedy is genuinely UNAVAILABLE rather than merely unused, say so in those
# words - a `const` at column 0 has no indentation to add. "No indentation needed"
# invites exactly the re-derivation above.
DESCRIBED = [
    # The only row left, and the only one of the six whose reason was ever a
    # measurement. Its retired anchor was a slice of `lib.rs`'s `pub use` list; a
    # later wave inserted `Records,` inside that slice and the anchor went to count 0.
    # Re-measured at `7a147c0`: the retired literal counts **0** in `keylink/src/lib.rs`
    # and re-quoting buys only until the next export lands, which puts the chore on
    # whoever adds one. This is the one mode where quoting is not worth it at all.
    ("R26a", "keylink/tests/api.rs", "positional",
     "a slice of lib.rs's `pub use` list - retired literal counts 0 at 7a147c0, and "
     "re-quoting buys only until the next export lands"),
]

def flat(text: str) -> str:
    """Whitespace-collapsed, so a literal wrapped across `///` lines still matches.

    A record's quote is broken by the comment's own wrapping; the target's copy is
    not. Comparing them raw finds nothing and reports a false failure - the same
    trap a plain `grep -c` over a record hits.
    """
    return " ".join(text.split())


cache: dict[str, str] = {}
spancache: dict[str, set[str]] = {}
bad = 0

for record, lives_in, target, literal in ANCHORS:
    if target not in cache:
        cache[target] = (ROOT / target).read_text()
    found = cache[target].count(literal)
    if found == 1:
        continue
    bad += 1
    same_file = lives_in == target
    if found == 0:
        reason = "IS GONE - `break-once.sh` aborts at its grep, before any backup"
        # Three causes, and the contributor's mental model differs for each: an edit
        # they made, a reflow nobody made, or a neighbour arriving in a list.
        likely = (
            "one of: (a) the line was edited; (b) the FORMATTER rewrapped it, which "
            "nobody wrote and nothing else would report; (c) POSITIONAL insertion - "
            "a sibling appeared inside an ordered construct the anchor spans, so the "
            "construct still exists and looks untouched"
        )
    elif same_file:
        reason = f"IS NOT UNIQUE ({found}x) - `break-once.sh` aborts on its count assert"
        likely = (
            "the record itself now quotes it - the same-file trap - unless the anchor "
            "is a FRAGMENT or a whole line whose text prefixes another, neither of "
            "which indentation can disambiguate"
        )
    else:
        reason = f"IS NOT UNIQUE ({found}x) - `break-once.sh` aborts on its count assert"
        # NOT the same-file trap, and saying so matters: for a cross-file row the
        # record's quote lives in a different file and CANNOT contribute to this
        # count. An earlier version named it anyway, one line above the two lines
        # that refute it - and a contributor sent to look for a cause that cannot
        # apply, finding nothing wrong, reaches for the deletion this task argues
        # against. BOTH arms fire in practice - the list holds cross-file and
        # same-file rows in comparable numbers - and which one you get is decided by
        # the row, not by the list.
        #
        # No split is written here on purpose. The first version said "11 cross-file
        # and 8 same-file" and was stale ONE COMMIT later, because six conversions in
        # the same range moved five rows to same-file and one to cross-file. The
        # conclusion is what this comment needs and the conclusion does not depend on
        # the ratio; a count here is a value this file cannot keep true.
        likely = (
            "a second occurrence appeared in the TARGET - a new call site, a copied "
            "line, or a doc comment there quoting it. It may also be a PREFIX "
            "COLLISION: your anchor is a whole line whose text begins another line, "
            "and it needs its trailing newline to be unique"
        )
    print(f"FAIL {record}: the anchor {reason}", file=sys.stderr)
    print(f"       likely cause:    {likely}", file=sys.stderr)
    print(f"       record lives in: {lives_in}", file=sys.stderr)
    print(f"       break edits:     {target}", file=sys.stderr)
    print(f"       anchor:          {literal}", file=sys.stderr)
    print(file=sys.stderr)

# ── is the anchor a WHOLE LINE? (mode 4, latent) ──────────────────────────────
#
# A fragment resolves fine until the day it does not, and then no remedy applies:
# indentation cannot disambiguate a mid-line span, and "re-quote against the line
# as it now reads" presumes there is a line. So a fragment anchor is a mode-4
# failure waiting for a sibling, worth naming while it is still green.
#
# Declared rather than forbidden, because one row already is one. The assertion is
# that the set does not GROW - the safe kind of count, no false-success state - so
# a new fragment reddens while this one stays visibly grandfathered.
FRAGMENT_ANCHORS = {
    # `(self.bound, self.iter().collect::<Vec<_>>())` - the line continues with
    # `.serialize(serializer)`. Count 1 today.
    #
    # Its own branch DESCRIBED a sibling fragment of exactly this shape,
    # `self.order.pop_front()`, while quoting this one. That inconsistency is now
    # resolved in the sibling's favour: it is C12 above, quoted as a WHOLE LINE,
    # which is mode 4's own remedy. **So the remedy is available here too, and taking
    # it means editing the record to quote the whole line - not widening this row,
    # which the record-quote check correctly rejects on its own.** Left as the record
    # quotes it, and declared, until somebody makes that record edit deliberately.
    "C6",
    # `$crate::__keylink_granted_id!(..)` sits inside a macro repetition, so the
    # whole line would drag `)+` and a trailing comma into the anchor. Count is 1
    # today. Left a fragment knowingly, and listed so the next one is not.
    "R28",
}

fragments = set()
for record, lives_in, target, literal in ANCHORS:
    if target not in cache:
        cache[target] = (ROOT / target).read_text()
    body = cache[target]
    at = body.find(literal)
    if at < 0:
        continue  # already reported above
    # Whether the anchor SPANS a complete line, not whether it was quoted with its
    # indentation. Records quote line content without leading whitespace as a matter
    # of course, and that is fine: `break-once.sh` matches the substring either way.
    # A first version of this check tested for a leading newline and flagged eight of
    # nine rows - it was measuring quoting style, not the mode-4 hazard.
    start = body.rfind("\n", 0, at) + 1
    end = body.find("\n", at)
    line = body[start:] if end < 0 else body[start:end]
    if line.strip() != literal.strip():
        fragments.add(record)

for record in sorted(fragments - FRAGMENT_ANCHORS):
    bad += 1
    print(f"FAIL {record}: the anchor is a FRAGMENT, not a whole line", file=sys.stderr)
    print("       It resolves today and has no remedy on the day it stops:",
          file=sys.stderr)
    print("       indentation cannot disambiguate a mid-line span. Take the whole",
          file=sys.stderr)
    print("       line including its indentation, or describe the edit instead.",
          file=sys.stderr)
    print(file=sys.stderr)
for record in sorted(FRAGMENT_ANCHORS - fragments):
    bad += 1
    print(f"FAIL {record}: listed in FRAGMENT_ANCHORS but its anchor is a whole "
          "line now - drop it from that set", file=sys.stderr)
    print(file=sys.stderr)

# ── and is it the literal the RECORD actually quotes? ─────────────────────────
#
# Without this the task is the very defect it exists to catch, one level up: it
# hardcodes a COPY of a value that lives in a doc comment in another file, so a
# rebase that correctly re-quotes a record and forgets this list leaves the gate
# validating a string no record uses - green.
#
# `local.rs`'s `no_failure_prefix_is_a_prefix_of_another` is NOT the precedent for
# a hand-written list of copies. Its own comment says it "names the consts rather
# than the strings, so it cannot drift from the wire" - hand-written *references*
# to one source of truth. A doc comment cannot be referenced from Python, so the
# copy is unavoidable here; what was avoidable is leaving it unchecked.
#
# ── the haystack is BACKTICKED SPANS IN COMMENTS, and both narrowings were bugs
#
# A first version searched the whole of `lives_in`, and that made this check a
# TAUTOLOGY for every same-file row: `lives_in == target`, so the CODE LINE
# satisfies the search by itself and the record need not quote anything at all.
# It was sound only while every row was cross-file. The rows registered from
# `call-id` took same-file from 0 to 8 of 19, and the check went inert for those 8
# without a single line of it changing - measured by re-quoting one record's
# literal, leaving its code alone, and watching the task still print `ok:`.
#
# Restricting to COMMENT LINES fixes that. Restricting further to what the comment
# BACKQUOTES, and demanding EQUALITY rather than containment, fixes a second hole
# in the same expression: `flat` collapses `        self.call\n` to `self.call`,
# which is a substring of the prose `self.call = call;`, `self.call.and(None)` and
# `self.call.filter(..)` in that same record. Four DISTINCT spans CONTAIN it and
# exactly one DISTINCT span EQUALS it, so equality is what distinguishes the record's
# search quote from its own replacement literals.
#
# Distinct, because the haystack below is a `set`. By OCCURRENCE the same measurement
# reads 6 and 2, since two records quote that anchor. Every other figure in this file
# is an occurrence count, so the unit is named here rather than inferred - a
# re-measurer who gets 6 and 2, disagrees, and re-derives is the failure the
# DESCRIBED header warns about.
#
# **Not by comparing indentation, which cannot work here.** The obvious reading -
# "compare the quoted form with its indentation" - reddens 9 of the 19 rows,
# measured. Records quote UNINDENTED on purpose: that is the whole mechanism that
# leaves the indented literal unique in the target (mode 1). Only C8's record
# quotes its anchor with the indentation, and a rule derived from that one row
# breaks the nine that follow the convention.
#
# Lines are joined BEFORE the spans are cut out, so a quote the comment wrapped
# across two `///` lines is still one span.
def quoted_spans(path: str) -> set[str]:
    """Every backticked span inside a comment of `path`, whitespace-flattened."""
    kept: list[str] = []
    for line in (ROOT / path).read_text().splitlines():
        stripped = line.strip()
        for marker in ("///", "//!", "//"):
            if stripped.startswith(marker):
                kept.append(stripped[len(marker):])
                break
    return {flat(span) for span in re.findall(r"`([^`]*)`", " ".join(kept))}


for record, lives_in, target, literal in ANCHORS:
    if lives_in not in spancache:
        spancache[lives_in] = quoted_spans(lives_in)
    if flat(literal) in spancache[lives_in]:
        continue
    bad += 1
    print(f"FAIL {record}: this task's literal is NOT QUOTED by its own record",
          file=sys.stderr)
    print(f"       record lives in: {lives_in}", file=sys.stderr)
    print(f"       task's literal:  {literal}", file=sys.stderr)
    print("       Looked for it as a `backticked` span inside a COMMENT of that",
          file=sys.stderr)
    print("       file, compared whole rather than as a substring - so neither the",
          file=sys.stderr)
    print("       code line nor a longer quote containing it will satisfy this.",
          file=sys.stderr)
    print("       The record was re-quoted and this list was not, or the row names",
          file=sys.stderr)
    print("       the wrong record. The RECORD is the source of truth; follow it.",
          file=sys.stderr)
    print(file=sys.stderr)

# ── population tripwire ───────────────────────────────────────────────────────
#
# A count, deliberately, and the safe kind: it can only fail LOUDLY. There is no
# state in which it passes while wrong, which is what separates it from the
# whole-target pass/fail counts this convention retired. The rule is not "never
# write a count" - it is "never write a count that can pass while wrong".
#
# What it buys: ADDING a break record forces a decision about registering it,
# instead of this list silently falling further behind a growing population.
#
# ── THE METHOD, because this number now fails the build when it moves ─────────
#
# A reviewer measured 86 where this says 98. Both are right for their own
# definitions, and neither is written down anywhere - so a contributor who trips
# this, re-measures by a different reasonable definition and gets a third number
# cannot tell which one the constant meant. It counts:
#
#   * both crates - `keylink/**/*.rs` AND `keylink-persist/**/*.rs`;
#   * contiguous runs of `///`, `//!` OR plain `//` lines, joined into one block,
#     so a `//` line adjacent to a `///` run merges into it;
#   * blocks whose joined text contains the string `break-once.sh`.
#
# Change any of those three and the number changes. The loop below IS the
# definition; this comment exists so the number can be reproduced without
# reading it.
#
# ── AND IT IS BLIND TO ROUGHLY A THIRD OF THE POPULATION ──────────────────────
#
# One marker, and records use three. Measured 2026-08-08 (-03:00) by the same walk,
# widened to `break-once.sh` OR "Made red" OR "Red under": **158 blocks match,
# 103 carry `break-once.sh`, so 55 do not** - a record phrased "Made red by .."
# without naming the harness does NOT move this count and the tripwire stays
# green. Two are in this repo's own `keylink/src/idempotency.rs`.
#
# **The blind figure did not move, and that is a coincidence rather than a result.**
# `parked-drain` added one record block that names the harness, so the widened count
# and the carrying count each rose by one and their difference happened to stay at
# 55. All three were re-derived from the tree here, because a subtraction whose two
# inputs both moved is exactly the shape that leaves a stale figure looking current.
#
# **And the 157 / 102 / 55 this replaces went stale inside one commit, past the one
# mitigation this convention relies on.** The date above was ALREADY 2026-08-08 when
# it was wrong: `parked-drain` moved `RECORD_BLOCKS` thirty lines below, and no
# reader could have told from the date that the snapshot predated that. A same-day
# figure is unfalsifiable by date alone, so the date is a tiebreaker between
# snapshots and never evidence that one is current.
#
# **The previous figures here said 144 / 98 / 46, and all three were stale for a
# reason the paragraph could not see: the rebase moved the tree underneath them.**
# They were measured before this branch rebased onto `call-id`, and the commit that
# wrote them is itself one of the six described below whose declared constant no
# longer matches its own tree. So the declared blind spot understated itself by
# nine blocks - the direction that matters, since this paragraph exists to bound
# what the tripwire cannot see.
#
# The date above carries its UTC offset because a bare date cannot be ordered
# against another bare date from a different zone - and "which of these two figures
# is older" is exactly the question a stale one makes somebody ask.
#
# Not widened, deliberately: the value here is LOUDNESS ON CHANGE, not
# completeness, and widening would move the number again while leaving some
# other phrasing outside. **So the limit is declared instead** - green here means
# the `break-once.sh` population is unchanged, and it is not a statement about
# every break record.
#
# The figure is a measurement rather than an assertion, and nothing checks it:
# it moves whenever anybody adds a record, which is precisely the property that
# disqualifies it from being a checked constant. Re-measure by widening MARKERS
# in the loop below to the three strings.
# ── the number, and what moved it last ────────────────────────────────────────
#
# 98 -> 102 when `call-id` merged (PR #11), which added four records mentioning
# the harness. **The tripwire fired and this is the decision it forced**, recorded
# rather than absorbed: those records carry quoted anchors that belong in ANCHORS
# above, and they are NOT registered here yet. Registration is tracked as its own
# task, because a candidate's SEARCH literal cannot be told from its watched output
# or its replacement mechanically - the sweep over those files returns roughly
# forty spans for ten anchors - so it needs the authoring branch's own list to
# cross-check against, and one list read twice is not a cross-check.
#
# Bumping the number without registering them is the one move this comment exists
# to make visible. Green here now means "the population is 102", not "102 records
# are checked". The ratio is not written here on purpose - a copy of it would go
# stale on the next row added. The success line COMPUTES it instead.
#
# ── A PROPERTY OF THIS CONSTANT THAT COSTS A BISECT, MEASURED ON THIS BRANCH ───
#
# **A constant measuring the WHOLE TREE is invalidated wholesale by a rebase, at
# every commit still carrying the old value.** Six commits on this branch declare 98
# while their own tree carries 102, so `mise run anchors` FAILS at each of them even
# though the tip is green. The constant was written measuring the pre-rebase tree;
# rebasing onto `call-id` moved the tree under all six at once, and only the commit
# that corrected the value is green again.
#
# The consequence is narrow and worth knowing before somebody hits it: **a bisect
# across a range containing such a rebase cannot use this gate**, because the
# failures are an artefact of where the range sits and not of the commits. Run the
# gate at the tip, or fix the constant at each step, or exclude this task from the
# bisect script. Nothing here needs changing for that - the tip is correct, and the
# alternative is a constant that measures less than the tree, which is the thing
# this one exists to be.
RECORD_BLOCKS = 103

harness_blocks: list[str] = []
for path in sorted(
    list((ROOT / "keylink").rglob("*.rs")) + list((ROOT / "keylink-persist").rglob("*.rs"))
):
    run, found = [], []
    for line in path.read_text().splitlines():
        stripped = line.strip()
        if stripped.startswith(("///", "//!", "//")):
            run.append(stripped)
        else:
            if run:
                found.append(" ".join(run))
            run = []
    if run:
        found.append(" ".join(run))
    harness_blocks += [b for b in found if "break-once.sh" in b]
blocks = len(harness_blocks)

# ── coverage: an INTERSECTION, because the two populations are different units ──
#
# The first version of the line below printed `RECORD_BLOCKS - len(ANCHORS)`, which
# **subtracts a row count from a block count**. It read as coverage, it was wrong,
# and it was wrong in the FLATTERING direction - 77 unchecked where the true figure
# is 89. Two reasons the subtraction cannot work:
#
#   * several rows can live in ONE block, so rows do not map onto blocks 1:1; and
#   * a row's record need not be a harness block at all. Eight of them are not: their
#     records say "Made red by .." without naming `break-once.sh`, which is exactly
#     the population the paragraph above declares this tripwire blind to. Those rows
#     cannot be "of those 102" in any sense.
#
# `882bd35` on this branch is the same defect one level up - **a gate cannot claim a
# denominator it cannot compute.** So the numbers below are an intersection measured
# both directions, and nothing is subtracted across units.
registered = {flat(literal) for _, _, _, literal in ANCHORS}
harness_spans = [
    {flat(span) for span in re.findall(r"`([^`]*)`", block)} for block in harness_blocks
]
blocks_carrying = sum(1 for spans in harness_spans if spans & registered)
quotable_anywhere = set().union(*harness_spans) if harness_spans else set()
rows_unseen = [rid for rid, _, _, lit in ANCHORS if flat(lit) not in quotable_anywhere]

if blocks != RECORD_BLOCKS:
    bad += 1
    print(f"FAIL population: {blocks} comment blocks mention break-once.sh, but "
          f"RECORD_BLOCKS says {RECORD_BLOCKS}.", file=sys.stderr)
    print("       A record was added or removed. Decide whether it needs a row",
          file=sys.stderr)
    print("       above - most will not, and that is fine - then update this",
          file=sys.stderr)
    print("       number. This exists so the decision is forced, not skipped.",
          file=sys.stderr)
    print(file=sys.stderr)

if bad:
    # The remedy belongs HERE and not only in RFC-08 §9.2, because a contributor
    # meets the failure and not the convention. Without it the shortest path to
    # green is to delete the entry — which removes the check while reporting
    # success, the exact silent-success case this task exists to prevent.
    print(
        f"{bad} of {len(ANCHORS)} quoted break anchors no longer resolve, so those\n"
        "records cannot be replayed and nothing else would have said so.\n"
        "\n"
        "THIS MEANS THE ANCHOR MOVED. FOLLOW IT.\n"
        "\n"
        "  Re-quote it against the line as it now reads. That is the fix for a\n"
        "  cross-file, line-local anchor, which is most of this list, and it is\n"
        "  the fix whenever a rebase or a refactor moved the target.\n"
        "\n"
        "Delete the entry ONLY in the three cases where quoting cannot work:\n"
        "\n"
        "  - the record lives in the file its break edits AND nothing separates\n"
        "    its own quote from the code's - so the quote is a second occurrence.\n"
        "    Check first that neither remedy applies: an INDENTED literal is\n"
        "    unique against an unindented quote, and a TRAILING NEWLINE is unique\n"
        "    against a quote closed by a backtick. Two rows here were described\n"
        "    for this reason and both turned out to be quotable;\n"
        "  - the anchor's uniqueness is a property of its NEIGHBOURS rather than\n"
        "    of the line - a `pub use` list item, a slice of an ordered list -\n"
        "    where re-quoting only buys until the next sibling lands; or\n"
        "  - the edit site SPANS MORE THAN ONE LINE, because `rustfmt` wrapped it\n"
        "    and the wrapping is not the author's to promise. This one is the\n"
        "    third case and it was missing from this list while the registry was\n"
        "    already using it. A one-line anchor merely sitting INSIDE a wrapped\n"
        "    chain does not qualify: that rots to count 0, which is loud, and\n"
        "    describing it instead removes the row from this gate entirely.\n"
        "\n"
        "  In those three - and ONLY those three - describe the search edit\n"
        "  instead. Quote the REPLACEMENT either way: it is never searched.\n"
        "\n"
        "  AND REPLAY THE RECORD FROM ITS NEW DESCRIPTION BEFORE DROPPING THE ROW.\n"
        "  A description is ungated: nothing checks that it locates the edit. The\n"
        "  first three conversions made under this rule included one that sent a\n"
        "  reader to a line where the guard passes, which reads as `this guard is\n"
        "  vacuous` and is false. Quoting is the safe side BECAUSE of this gate.\n"
        "\n"
        "Deleting an entry is the shortest path to green and it is usually the\n"
        "wrong one: it makes the record unchecked rather than correct. If you are\n"
        "mid-rebase and reaching for it, that is the moment this paragraph is for.\n"
        "RFC-08 §9.2 carries the full argument.",
        file=sys.stderr,
    )
    sys.exit(1)

print(
    f"ok: {len(ANCHORS)} REGISTERED rows resolve to exactly one occurrence "
    f"({len({literal for _, _, _, literal in ANCHORS})} distinct literals; "
    "registration is per-record and opt-in - see this task's header)"
)
print(
    f"    {len(DESCRIBED)} more {'is' if len(DESCRIBED) == 1 else 'are'} recorded as "
    "deliberately DESCRIBED rather than quoted - documentation, not a check"
)
# Computed, never written down: the tripwire agreeing with the population says the
# population has not MOVED, and says nothing about how much of it is registered.
# Anybody reading the two lines above as coverage needs this third one - and it
# reports each population in ITS OWN unit, because the first version of this line
# subtracted rows from blocks and overstated coverage by twelve blocks.
print(
    f"    {blocks_carrying} of the {blocks} harness blocks carry a registered row, "
    f"so {blocks - blocks_carrying} do not"
)
print(
    f"    and {len(rows_unseen)} of the {len(ANCHORS)} rows sit in records this "
    "tripwire cannot see at all - they never say `break-once.sh`"
)
