def script(path: pathlib.Path) -> bool:
    """Whether a suffix-less file is a script, decided by its first two BYTES.

    `.githooks/` is globbed whole rather than by suffix, because its files have no
    suffix - so anything that lands there is handed to this walk. **`read_text()` on a
    non-UTF-8 file raises `UnicodeDecodeError`, which turns this gate into a traceback
    rather than a diagnostic**, and the platform makes that concrete: a stray
    `.DS_Store` in `.githooks/` is one Finder visit away, and git's own `*.sample` files
    live there too. Measured: `read_text()` on a file whose third byte is `0x82` raises.

    Reading the shebang as BYTES cannot raise, so the filter is the guard. `scripts/*.sh`
    needs none - it is suffix-filtered already.
    """
    with path.open("rb") as handle:
        return handle.read(2) == b"#!"


