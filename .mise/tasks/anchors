# the alternative and is worse - the arm is CORRECT, and a Python module without a
# shebang is exactly the case the suffix list exists to place, since the shebang clause
# cannot see it.
PROBES = (
    ("probe.sh", "set -eu\n# replacing `expected_len=64` with 40.\n"),
    ("hooks/probe", "#!/usr/bin/env bash\n# replacing `expected_len=64` with 40.\n"),
    ("probe.py", "import os\n# replacing `expected_len=64` with 40.\n"),
