# this is what stops the state returning.
#
# A set or a dict cannot express this check - both collapse the duplicate they are
# asked about - so it counts over the LIST, which is the only place both rows still
# exist.
appearances: dict[str, int] = {}
for record, _, _, _ in ANCHORS:
    appearances[record] = appearances.get(record, 0) + 1
for record, count in sorted(item for item in appearances.items() if item[1] > 1):
