    print(f"FAIL {record}: {count} ANCHORS rows share this id", file=sys.stderr)
    print("       A row id is the name `mise run replay-anchors` resolves a replay",
          file=sys.stderr)
    print("       by, and it resolves it through a dict - so the LAST of these rows",
          file=sys.stderr)
    print("       wins and the others are unreachable. If they are different breaks,",
          file=sys.stderr)
    print("       give each its own id. If they are one break, delete the copies.",
          file=sys.stderr)
    print(file=sys.stderr)

