    print("       search literal is quoted and checked, and that quoting it was",
          file=sys.stderr)
    print("       MEASURED to be impossible. If the record quotes an anchor now,",
          file=sys.stderr)
    print("       the ANCHORS row is the live one - drop the DESCRIBED entry.",
          file=sys.stderr)
    print(file=sys.stderr)

