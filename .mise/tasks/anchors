    ("R11", "keylink/src/idempotency.rs", "keylink/src/idempotency.rs",
     "        if self.progress.as_ref().map(Progress::reached) == Some(Reached::NotDispatched) {"),
    ("R19", "keylink/tests/idempotency.rs", "keylink/tests/idempotency.rs",
     "                .keyable(Keyable::Only(&[\"Reserve\"]))"),
    # C14, formerly `C-D3`, said its edit site spans three lines so no anchor exists.
    # True of the SITE and false of the ANCHOR: `break-once.sh` searches one literal
    # and substitutes anything, so a one-line search with a MULTI-LINE replacement is
    # legal. `.iter()` alone counts 2 and is unusable; the `.filter_map` line counts 1.
