#!/usr/bin/env bash
# MISE description="Drive every gateway route against a real process with curl"
#
# The narrow smoke (`http-smoke`) drives the singleton `rpc` surface, which is
# what the first task shipped. This one drives everything the plan added after
# it: streaming both ways, blob lookup and bytes, ranges, conditionals, the
# keyed surface, and the two document endpoints.
#
# Real curl against a real listener on purpose. Every other test in this
# workspace goes through `reqwest` or `tower`, both of which normalise things a
# deployment's client will not — a `Range` header curl writes, a `HEAD` that
# really sends no body, a 416 a library might hide.
set -euo pipefail

scratch="$(mktemp -d "${TMPDIR:-/tmp}/keylink-http-smoke-full.XXXXXX")"
server_pid=""
passed=false
failures=0

cleanup() {
    rc=$?
    if [[ "$passed" != true ]]; then
        echo "--- server log" >&2
        cat "$scratch/server.log" >&2 2>/dev/null || true
    fi
    if [[ -n "$server_pid" ]]; then
        kill -TERM "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -rf "$scratch"
    exit "$rc"
}
trap cleanup EXIT

mkfifo "$scratch/url"
cargo run -p keylink-openapi --example gateway >"$scratch/url" 2>"$scratch/server.log" &
server_pid=$!
IFS= read -r base <"$scratch/url"

allow=(--header 'Authorization: Bearer allow')
deny=(--header 'Authorization: Bearer deny')
json=(--header 'Content-Type: application/json')

# `check <name> <expected> <actual>` — every failure is reported, and the run
# fails at the end. Stopping at the first one hides how much else is broken,
# which is the wrong trade for a smoke that takes one process start.
check() {
    if [[ "$2" == "$3" ]]; then
        printf 'ok   %s\n' "$1"
    else
        printf 'FAIL %s: expected %q, got %q\n' "$1" "$2" "$3" >&2
        failures=$((failures + 1))
    fi
}

status_of() { curl --silent --output "$scratch/body" --write-out '%{http_code}' "$@"; }
header_of() { curl --silent --output /dev/null --write-out "%{$1}" "${@:2}"; }

# ── singleton rpc ───────────────────────────────────────────────────────────
printf '{"left":2,"right":3}' >"$scratch/add.json"
check "rpc Add" 200 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/add.json" "$base/inventory/rpc/Add")"
check "rpc Add body" 5 "$(<"$scratch/body")"

check "rpc denied" 403 "$(status_of "${deny[@]}" "${json[@]}" --data-binary "@$scratch/add.json" "$base/inventory/rpc/Add")"
check "rpc unauthenticated" 401 "$(status_of "${json[@]}" --data-binary "@$scratch/add.json" "$base/inventory/rpc/Add")"
check "rpc unknown method" 404 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/add.json" "$base/inventory/rpc/Nope")"
check "rpc wrong verb" 405 "$(status_of "${allow[@]}" --request GET "$base/inventory/rpc/Add")"

printf '{' >"$scratch/malformed.json"
check "rpc malformed body" 400 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/malformed.json" "$base/inventory/rpc/Add")"

# A `tell` has no route in either address space.
check "tell has no route" 404 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/add.json" "$base/inventory/rpc/Audit")"

# ── idempotency: one key, one operation ─────────────────────────────────────
printf '{"value":7}' >"$scratch/count.json"
first=$(curl --silent "${allow[@]}" "${json[@]}" --header 'Idempotency-Key: smoke' --data-binary "@$scratch/count.json" "$base/inventory/rpc/Count")
again=$(curl --silent "${allow[@]}" "${json[@]}" --header 'Idempotency-Key: smoke' --data-binary "@$scratch/count.json" "$base/inventory/rpc/Count")
check "rpc replays under one key" "$first" "$again"

# ── send: raw bytes in, arguments in a header ───────────────────────────────
printf 'PAYLOAD-BYTES' >"$scratch/upload.bin"
args=$(printf '{"name":"abc"}' | base64 | tr -d '=\n' | tr '/+' '_-')
check "send Upload" 200 "$(status_of "${allow[@]}" \
    --header 'Content-Type: application/octet-stream' \
    --header "Keylink-Arguments: $args" \
    --data-binary "@$scratch/upload.bin" "$base/inventory/send/Upload")"
check "send Upload body" 16 "$(<"$scratch/body")"
check "send refuses a replay key" 400 "$(status_of "${allow[@]}" \
    --header 'Content-Type: application/octet-stream' \
    --header "Keylink-Arguments: $args" --header 'Idempotency-Key: smoke' \
    --data-binary "@$scratch/upload.bin" "$base/inventory/send/Upload")"

# ── recv: JSON in, bytes out, declared value in a header ────────────────────
printf '{"sku":"ab"}' >"$scratch/fetch.json"
check "recv Fetch" 200 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/fetch.json" "$base/inventory/recv/Fetch")"
check "recv Fetch body" "ababab" "$(<"$scratch/body")"
result=$(header_of 'header_json' "${allow[@]}" "${json[@]}" --data-binary "@$scratch/fetch.json" "$base/inventory/recv/Fetch" | grep -o '"keylink-result":\["[^"]*"\]' || true)
check "recv carries a declared value" 0 "$([[ -n "$result" ]] && echo 0 || echo 1)"

# ── blob: a lookup mints a grant, the bytes are a separate resource ─────────
printf '{"sku":"x"}' >"$scratch/sheet.json"
location=$(curl --silent --output "$scratch/body" --write-out '%{redirect_url}\n%{header_json}' \
    "${allow[@]}" "${json[@]}" --data-binary "@$scratch/sheet.json" \
    "$base/inventory/blob/Datasheet" | grep -o '"location":\["[^"]*"\]' | sed 's/.*\["//;s/"\].*//' || true)
check "blob lookup mints a Location" 0 "$([[ -n "$location" ]] && echo 0 || echo 1)"

check "blob GET whole" 200 "$(status_of "${allow[@]}" "$base$location")"
check "blob GET whole body" "0123456789abcdefghijklmnopqrstuvwxyz" "$(<"$scratch/body")"
check "blob HEAD" 200 "$(curl --silent --head --output /dev/null --write-out '%{http_code}' "${allow[@]}" "$base$location")"
# `size_download`, not the output file: curl writes HEADERS to the output on a
# `--head`, so measuring the file would measure the headers.
check "blob HEAD sends no body" 0 "$(curl --silent --head --output /dev/null --write-out '%{size_download}' "${allow[@]}" "$base$location")"
# The length a HEAD promises is the length its GET would send. RFC 9110 §9.3.2.
# Raw headers, not `%{header_json}`: an ETag is a quoted string, so its JSON
# rendering carries escaped quotes and a naive extraction stops at the first.
curl --silent --head --output /dev/null --dump-header "$scratch/head.txt" "${allow[@]}" "$base$location"
header() { grep -i "^$1:" "$scratch/head.txt" | tr -d '\r' | cut -d' ' -f2- || true; }
check "blob HEAD carries a length" 36 "$(header content-length)"

check "blob GET range" 206 "$(status_of "${allow[@]}" --header 'Range: bytes=2-5' "$base$location")"
check "blob GET range body" "2345" "$(<"$scratch/body")"
check "blob GET unsatisfiable range" 416 "$(status_of "${allow[@]}" --header 'Range: bytes=9999-' "$base$location")"

etag=$(header etag)
check "blob carries an ETag" 0 "$([[ -n "$etag" ]] && echo 0 || echo 1)"
check "blob conditional GET" 304 "$(status_of "${allow[@]}" --header "If-None-Match: $etag" "$base$location")"

# A wrong verb on a BYTE route. These register through a `MethodRouter` rather
# than `any()`, and axum's default for one is a bare 405 with no body — which
# the crate documentation, the README and the published OpenAPI all contradict.
check "blob wrong verb" 405 "$(status_of "${allow[@]}" --request POST "$base$location")"
check "blob wrong verb is JSON" "application/json" "$(header_of 'content_type' "${allow[@]}" --request POST "$base$location")"
check "blob wrong verb is uncacheable" 0 "$(curl --silent --output /dev/null --dump-header "$scratch/verb.txt" "${allow[@]}" --request POST "$base$location"; grep -qi '^cache-control: private, no-store' "$scratch/verb.txt" && echo 0 || echo 1)"
# axum fills the verb set per path; a fallback that set its own would answer
# `Allow: POST` on a route serving GET and HEAD.
check "blob wrong verb allows its own verbs" 0 "$(grep -qi '^allow: GET,HEAD' "$scratch/verb.txt" && echo 0 || echo 1)"

check "blob GET denied" 403 "$(status_of "${deny[@]}" "$base$location")"
check "blob GET unknown address" 404 "$(status_of "${allow[@]}" "$base/inventory/blob/Datasheet/$(printf 'ab%.0s' {1..32})")"

# ── keyed actors ────────────────────────────────────────────────────────────
printf '{}' >"$scratch/empty.json"
check "actor rpc" 200 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/empty.json" "$base/bays/bay-1/rpc/Whoami")"
check "actor rpc body" '"bay-1"' "$(<"$scratch/body")"
# `%2F` stays one id rather than becoming a separator.
check "actor id with an encoded slash" 200 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/empty.json" "$base/bays/bay%2F2/rpc/Whoami")"
check "actor id with an encoded slash body" '"bay/2"' "$(<"$scratch/body")"
check "actor recv" 200 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/fetch.json" "$base/bays/bay-1/recv/Fetch")"
check "actor recv body" "bay-1" "$(<"$scratch/body")"
# The keyed blob LOOKUP and the keyed blob BYTES are two routes, and only the
# first was driven here — the script minted a `Location` and never followed it.
# That left one of the nine templates in the crate's own route table
# unexercised while this file printed "every route answered as documented".
keyed_location=$(curl --silent --output /dev/null --dump-header "$scratch/keyed.txt" \
    "${allow[@]}" "${json[@]}" --data-binary "@$scratch/sheet.json" \
    "$base/bays/bay-1/blob/Datasheet"; grep -i '^location:' "$scratch/keyed.txt" | tr -d '\r' | cut -d' ' -f2 || true)
check "actor blob lookup" 201 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/sheet.json" "$base/bays/bay-1/blob/Datasheet")"
check "actor blob mints a Location" 0 "$([[ -n "$keyed_location" ]] && echo 0 || echo 1)"
check "actor blob GET" 200 "$(status_of "${allow[@]}" "$base$keyed_location")"
check "actor blob GET body" "0123456789abcdefghijklmnopqrstuvwxyz" "$(<"$scratch/body")"
check "actor blob GET range" 206 "$(status_of "${allow[@]}" --header 'Range: bytes=0-3' "$base$keyed_location")"
check "actor blob HEAD" 200 "$(curl --silent --head --output /dev/null --write-out '%{http_code}' "${allow[@]}" "$base$keyed_location")"
# A grant minted under one actor is not a grant under another.
check "actor blob is bound to its actor" 404 "$(status_of "${allow[@]}" "$base${keyed_location/\/bay-1\//\/bay%2F2\/}")"
check "actor missing" 404 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/empty.json" "$base/bays/absent/rpc/Whoami")"
check "actor malformed id" 404 "$(status_of "${allow[@]}" "${json[@]}" --data-binary "@$scratch/empty.json" "$base/bays/a%2/rpc/Whoami")"
check "actor wrong verb beats a bad id" 405 "$(status_of "${allow[@]}" --request GET "$base/bays/a%2/rpc/Whoami")"
# A keyed surface serves no `send`.
check "actor send has no route" 404 "$(status_of "${allow[@]}" --header 'Content-Type: application/octet-stream' --data-binary "@$scratch/upload.bin" "$base/bays/bay-1/send/Upload")"

# ── the documents ───────────────────────────────────────────────────────────
check "openapi.json" 200 "$(status_of "$base/openapi.json")"
check "openapi media type" "application/vnd.oai.openapi+json;version=3.1" "$(header_of 'content_type' "$base/openapi.json")"
check "openapi declares 3.1.0" 0 "$(grep -q '"openapi": "3.1.0"' "$scratch/body" && echo 0 || echo 1)"
check "schema.json" 200 "$(status_of "$base/schema.json")"
check "schema media type" "application/schema+json" "$(header_of 'content_type' "$base/schema.json")"
check "spec HEAD" 200 "$(status_of --head "$base/openapi.json")"

# ── the inventory this smoke drives ─────────────────────────────────────────
#
# Watched red by replacing `check "rpc Add" 200 ` with `check "rpc Add" 201 `
# and re-running: `FAIL rpc Add: expected 201, got 200`, `1 check(s) failed`,
# `EXIT=1`. Measured directly rather than through `scripts/break-once.sh`, which
# drives a cargo test filter and reports `selected=?` for a shell target — a `?`
# is a compile-or-selection failure, not a red, and recording one as a red is
# the exact mistake this file's harness exists to prevent.
#
# What that row pins is the smoke's own inventory: every family the gateway
# serves appears above, and a check that stops matching the gateway fails the
# gate rather than being quietly wrong. It is the closest a shell script gets to
# an anchored guard — `mise.toml`'s example list is prose the anchors walk does
# not read, and that gap is recorded in the delivery record rather than papered
# over.
expected_families=(rpc send recv blob actor openapi schema)
for family in "${expected_families[@]}"; do
    if ! grep -qi "^check \"$family\|^check \"blob\|^check \"actor" "$0"; then
        printf 'FAIL this smoke no longer drives %s\n' "$family" >&2
        failures=$((failures + 1))
    fi
done

if (( failures > 0 )); then
    printf '\n%d check(s) failed\n' "$failures" >&2
    exit 1
fi
passed=true
printf '\nevery route in the crate table answered as documented\n'
