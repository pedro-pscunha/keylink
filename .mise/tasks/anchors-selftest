#!/usr/bin/env python3
"""`mise run anchors` must name the failure it actually has.

MISE description="The anchors gate reports each failure class as itself, not as anchor rot"
"""
# This exists because the gate had ONE counter for every check and printed the
# anchor-rot playbook on all of them. The population tripwire fires for every
# branch that adds a record block — the normal case — so the normal case produced
# `N of M quoted break anchors no longer resolve` plus thirty lines headed
# `THIS MEANS THE ANCHOR MOVED. FOLLOW IT.` about rot that did not exist.
#
# A wrong count gets distrusted; a wrong DIAGNOSIS with a procedure attached gets
# followed. So the fix needs a guard, and the guard has to assert BOTH directions:
# the playbook must be absent when no anchor moved, and present when one did.
# Asserting only the absence would pass on a build that never prints it at all.
#
# ── why this perturbs a COPY and never the tree ──────────────────────────────
#
# The obvious shape is `scripts/break-once.sh`, and it does not fit: that harness
# runs `cargo test`, and the thing under test here is a Python gate. The next
# shape is to edit `.mise/tasks/anchors` in place and restore it — which is the
# orphan hazard that harness already carries, in a script with no `trap`. So this
# copies the task to a temp file, perturbs the COPY, and runs that. The tree is
# never written to, so an interrupted run cannot leave a stale restore behind.
#
# The copy still resolves the repo correctly: the task computes ROOT from
# `git rev-parse --show-toplevel`, which answers from the cwd and not from the
# script's own path. So a copy in /tmp reads the same tree the original would.
import ast
import pathlib
import re
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
)
# The task under test, overridable by argv[1] so that THIS GUARD IS ITSELF
# TESTABLE: point it at a deliberately drifted copy and it must go red. Without
# that the only way to check the guard was to edit the tree, which is the hazard
# the temp-copy design exists to avoid — so the override is not a convenience, it
# is what lets the guard be verified the same way it verifies the gate.
TASK = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / ".mise" / "tasks" / "anchors"
PLAYBOOK = "THIS MEANS THE ANCHOR MOVED"

source = TASK.read_text()
failures: list[str] = []


def run(text: str) -> tuple[int, str]:
    """Run a perturbed copy of the task and return its exit code and merged output."""
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as tmp:
        tmp.write(text)
        path = tmp.name
    try:
        done = subprocess.run(
            [sys.executable, path], capture_output=True, text=True, cwd=ROOT
        )
        return done.returncode, done.stdout + done.stderr
    finally:
        pathlib.Path(path).unlink(missing_ok=True)


def check(name: str, condition: bool, detail: str) -> None:
    if condition:
        print(f"ok: {name}")
    else:
        failures.append(name)
        print(f"FAIL {name}", file=sys.stderr)
        print(f"     {detail}", file=sys.stderr)


# ── the tree as it stands must be green, or the two probes below prove nothing ──
#
# A gate that is already red would satisfy "exits 1" for the wrong reason, and the
# absence probe would then be measuring the wrong run.
code, out = run(source)
check(
    "the unperturbed task passes",
    code == 0,
    f"exit {code}; the probes below cannot be trusted until this is green:\n{out}",
)

# ── probe 1: the population tripwire must NOT claim an anchor moved ────────────
#
# Perturbing RECORD_BLOCKS is exactly what a branch adding records does to this
# gate, so this probe is the normal case rather than an exotic one.
blocks = re.search(r"^RECORD_BLOCKS = (\d+)$", source, re.M)
if blocks is None:
    check("RECORD_BLOCKS is findable", False, "no `RECORD_BLOCKS = <n>` line in the task")
else:
    wrong = int(blocks.group(1)) + 1
    code, out = run(
        source.replace(blocks.group(0), f"RECORD_BLOCKS = {wrong}", 1)
    )
    check("a population mismatch fails the gate", code == 1, f"exit {code}, expected 1")
    check(
        "a population mismatch says so",
        "FAIL population" in out,
        "expected `FAIL population` in the output",
    )
    check(
        "a population mismatch does NOT print the anchor-rot playbook",
        PLAYBOOK not in out,
        "the playbook fired for a failure that is not anchor rot - this is the "
        "defect the two-counter split fixes, and it has come back",
    )
    # The message's CONTENT, not just which block fired. The counter split stops the
    # rot playbook arriving; these three assert the population failure says the right
    # thing on its own, because that is what a contributor actually reads.
    check(
        "a population mismatch names the number counted from the tree",
        f"to {int(blocks.group(1))}," in out,
        "the failure should state the measured count as the value to set, or the "
        "contributor computes one instead",
    )
    check(
        "a population mismatch says re-measure and never carry",
        "RE-MEASURE, never carry" in out,
        "the re-measure instruction is missing - a value carried across a rebase is "
        "the way this constant goes stale",
    )
    check(
        "a population mismatch forbids deleting a row",
        "NOTHING here asks you to delete a row" in out,
        "the shortest path out of this message must not be deletion: removing a row "
        "turns a working check into a silent pass, and that is what the wrong "
        "playbook used to point at",
    )

# ── probe 2: a real resolution failure MUST print the playbook ─────────────────
#
# The other direction, and the one that stops the fix from being "never print it".
#
# ── why this perturbs the TARGET and not the LITERAL, which is where the first
#    version of this probe was wrong ──────────────────────────────────────────
#
# Corrupting a row's literal looks like the obvious rot and is **unusable as an
# attribution probe**, because TWO checks read a literal: resolution reads it
# against `target`, and the record-quote check reads it against `lives_in`. A
# corrupted literal fails both. The record-quote check then supplies `bad` on its
# own, forcing exit 1 — so the probe passes even when resolution has stopped
# contributing to `bad` at all, and **that is precisely the drift that produces a
# green gate printing the rot playbook.** The probe would have watched the defect
# go by.
#
# Repointing `target` at another existing file fires exactly ONE check: resolution
# reads a file that does not contain the literal, while the record-quote check
# reads the unchanged `lives_in` and stays happy. So the exit code is attributable
# to resolution, which is the only thing this probe is trying to assert.
#
# Verified both ways rather than reasoned: delete `bad += 1` from the resolution
# loop and this probe returns exit 0, so `a rotted anchor fails the gate` reddens.
# Run this guard against a drifted copy — `anchors-selftest <path>` — to see it.
row = re.search(r'^    \("([^"]+)", "([^"]+)", "([^"]+)",', source, re.M)
if row is None:
    check("an ANCHORS row is findable", False, "could not locate a row to perturb")
else:
    rid, lives_in, target = row.group(1), row.group(2), row.group(3)
    # A file that certainly exists and certainly does not hold the first row's
    # literal. Chosen from the repo rather than invented, so the failure is a real
    # count-0 rot and not a missing-file error on a different code path.
    decoy = "Cargo.toml" if target != "Cargo.toml" else "README.md"
    broken = source.replace(
        f'("{rid}", "{lives_in}", "{target}",',
        f'("{rid}", "{lives_in}", "{decoy}",',
        1,
    )
    code, out = run(broken)
    check("a rotted anchor fails the gate", code == 1, f"exit {code}, expected 1")
    check(
        "a rotted anchor DOES print the anchor-rot playbook",
        PLAYBOOK in out,
        f"row {rid} was made unresolvable and the playbook did not fire - the "
        "remedy is now unreachable for the failure it belongs to",
    )
    check(
        "a rotted anchor names the row",
        f"FAIL {rid}" in out,
        f"expected `FAIL {rid}` in the output",
    )

# ── probe 3: a row in ANCHORS and DESCRIBED at once ────────────────────────────
#
# The two lists say opposite things about one record, so an id in both is a defect
# the gate must name. Perturbed by splicing over the id's own character range rather
# than by `str.replace`, because an id is a short string that occurs in prose too.
described = re.search(r'^DESCRIBED = \[\n(?:.*\n)*?    \("([^"]+)",', source, re.M)
if described is None or row is None:
    check("a DESCRIBED row is findable", False, "could not locate a row to perturb")
else:
    at, to = described.span(1)
    code, out = run(source[:at] + rid + source[to:])
    check("a row in ANCHORS and DESCRIBED at once fails the gate", code == 1,
          f"exit {code}, expected 1")
    check(
        "a row in both lists is named",
        f"FAIL {rid}" in out and "DESCRIBED at once" in out,
        f"expected `FAIL {rid}` and `DESCRIBED at once` in the output",
    )
    check(
        "a row in both lists does NOT print the anchor-rot playbook",
        PLAYBOOK not in out,
        "no anchor moved: the playbook's remedy is re-quoting, and this failure is "
        "two lists disagreeing about one record",
    )

# ── probe 4: a REDNESS entry naming no row ─────────────────────────────────────
#
# `replay-anchors` reads the file and the search literal from `ANCHORS`, so an entry
# whose id is not a row is a replay that cannot run — and nothing would say so,
# because no gate runs the replayer.
redness = re.search(r'^REDNESS = \{\n    "([^"]+)":', source, re.M)
if redness is None:
    check("a REDNESS entry is findable", False, "no `REDNESS = {` with a first key")
else:
    at, to = redness.span(1)
    code, out = run(source[:at] + "ZZ99" + source[to:])
    check("a REDNESS entry naming no row fails the gate", code == 1,
          f"exit {code}, expected 1")
    check(
        "a REDNESS entry naming no row is named",
        "FAIL ZZ99" in out and "no ANCHORS row" in out,
        "expected `FAIL ZZ99` and `no ANCHORS row` in the output",
    )
    check(
        "a REDNESS entry naming no row does NOT print the anchor-rot playbook",
        PLAYBOOK not in out,
        "no anchor moved: this is a replay entry pointing at nothing",
    )

# ── the summary's figures must be DERIVED, and its states must be printed ──────
#
# Three hand-written figures declared the tripwire's blind spot and all three went
# stale, always understating it. They are computed now, so what is worth asserting is
# that the arithmetic in the output is the SAME RUN's arithmetic: a literal spliced
# back in over any one of the figures below stops agreeing with the others. That is
# what this can catch and the limit of it — figures off one walk are not independent
# measurements, so agreement is consistency and not proof.
#
# **A CASE NAME IS NOT A CHECK, and this one was named for an addition it never did.**
# "the unclassified blocks are the seen and the unseen added up" compared the blind
# count with ITSELF across two output lines: it never read the UNCLASSIFIED total and
# never added anything. Measured by splicing `999` over one printed expression at a
# time and running this file against the copy: the UNCLASSIFIED total, the `this walk
# sees` figure and `blocks_carrying` in the harness-block line were all GREEN, and only
# the widened line's `{blind}` went red. So every column of the state table this
# convention exists to print was unread, including its own total.
#
# Each figure in the summary is now read by a case, and each splice named above reddens
# the case whose name describes it. Re-measured after the fix: those three go red, the
# two second copies of a figure - the state table's `it does not` column and the
# harness-block line's `so N do not` tail - go red as well, and the CHECKED row's row
# column reddens against the resolution line.
code, out = run(source)
widened = re.search(r"the walk finds (\d+) record blocks, so (\d+) name no harness", out)
counted = re.search(
    r"(\d+) of the (\d+) harness blocks carry a registered row, so (\d+) do not", out
)
checked = re.search(r"CHECKED\s+(\d+)\s+(\d+)", out)
resolved = re.search(r"ok: (\d+) REGISTERED rows resolve", out)
unclassified = re.search(
    r"UNCLASSIFIED\s+-\s+(\d+)\s+\((\d+) this walk sees, (\d+) it does not\)", out
)
check(
    "the summary states the widened population, the blind count and the state table",
    None not in (widened, counted, checked, unclassified, resolved),
    f"expected the resolution line, the widened line, the harness-block line and the "
    f"CHECKED and UNCLASSIFIED rows of the state table:\n{out}",
)
if widened and counted and checked and unclassified and resolved:
    check(
        "the blind count is that run's own subtraction",
        int(widened.group(2)) == int(widened.group(1)) - int(counted.group(2)),
        f"{widened.group(1)} widened - {counted.group(2)} counted != "
        f"{widened.group(2)} blind: one of the three is not from this walk",
    )
    check(
        "the unclassified blocks are the seen and the unseen added up",
        int(unclassified.group(1))
        == int(unclassified.group(2)) + int(unclassified.group(3)),
        f"the state table's UNCLASSIFIED total is {unclassified.group(1)} while its "
        f"own two parts are {unclassified.group(2)} seen and "
        f"{unclassified.group(3)} unseen",
    )
    check(
        "the CHECKED row and the harness-block line agree on the carrying figure",
        int(checked.group(2)) == int(counted.group(1))
        and int(counted.group(2)) - int(counted.group(1)) == int(counted.group(3)),
        f"the CHECKED row says {checked.group(2)} carrying blocks while the "
        f"harness-block line says {counted.group(1)} of {counted.group(2)}, "
        f"{counted.group(3)} not carrying",
    )
    check(
        "the CHECKED row's row column is the resolution line's own count",
        int(checked.group(1)) == int(resolved.group(1)),
        f"the CHECKED row says {checked.group(1)} rows while the resolution line "
        f"says {resolved.group(1)}",
    )
check(
    "the summary prints the replay coverage, so the sample cannot read as the whole",
    "carry a WATCHED REPLAY" in out,
    "REDNESS samples the registry; a run that does not print the ratio lets a "
    "reviewer read a partial replay as a whole-registry one",
)
check(
    "the summary prints the unclassified population rather than hiding it",
    "UNCLASSIFIED" in out,
    "the three-state classification exists to make the unclassified blocks visible; "
    "a summary without them is the sweep this convention refuses",
)

# ── the READER, on synthetic input, because the hazard is LATENT in this tree ───
#
# No registered literal is quoted only in wrapped form, so no perturbation of the
# TREE can redden a check for the wrapped-quote defect — a probe that ran the whole
# task would pass with either reader. The reader is therefore exercised directly, on
# text written here for the purpose.
#
# `ast` lifts the functions out of the task and executes those alone, so this neither
# runs the gate nor touches the tree.
READER = ("flat", "comment_blocks", "spans", "markers_for")
MARKER_SETS = ("MARKERS", "HASH_MARKERS", "HASH_SUFFIXES")
reader: dict = {"re": re, "pathlib": pathlib}
lifted = [
    node
    for node in ast.parse(source).body
    if (isinstance(node, ast.FunctionDef) and node.name in READER)
    or (isinstance(node, ast.Assign)
        and getattr(node.targets[0], "id", "") in MARKER_SETS)
]
exec(compile(ast.Module(body=lifted, type_ignores=[]), str(TASK), "exec"), reader)
check(
    "the task's comment reader is liftable by name",
    set(READER) | set(MARKER_SETS) <= set(reader),
    f"expected {', '.join(READER + MARKER_SETS)} at the task's top level; the cases "
    "below read the reader by those names",
)

# ── THE SINGLE-DEFINITION ASSERTION COVERS EVERY MARKER SET, NOT JUST THE RUST ONE
#
# It used to match one hard-coded triple, `["///", "//!", "//"]`. That was the whole
# policy when the reader had one marker set — and once `HASH_MARKERS` existed, a SECOND
# `("#",)` literal anywhere in the task would have passed this check in silence, which is
# the exact hazard the failure message below names. The predicate is now derived from the
# sets the task itself defines, so adding a third one extends this check for free instead
# of leaving it behind.
if set(MARKER_SETS) <= set(reader):
    wanted = {name: list(reader[name]) for name in MARKER_SETS}
    copies = {name: 0 for name in MARKER_SETS}
    for node in ast.walk(ast.parse(source)):
        if not isinstance(node, ast.Tuple):
            continue
        value = [getattr(e, "value", None) for e in node.elts]
        for name, target in wanted.items():
            if value == target:
                copies[name] += 1
    duplicated = {name: n for name, n in copies.items() if n != 1}
    check(
        "every marker set is written down exactly once",
        not duplicated,
        f"marker-set literal counts are {copies}, and each must be 1. Two readers with "
        "two copies is how the record-quote check and the population walk came to "
        "disagree, and the disagreement was invisible because both were green",
    )
if {"comment_blocks", "spans"} <= set(reader):
    WRAPPED = (
        "impl Ledger {\n"
        "    /// Made red by `scripts/break-once.sh` replacing `inner.spent =\n"
        "    /// inner.spent.saturating_sub(1);` with `saturating_sub(0)`.\n"
        "    fn evict(&mut self) {}\n"
        "}\n"
    )
    blocks = reader["comment_blocks"](WRAPPED)
    wrapped_spans = set().union(*(reader["spans"](b) for b in blocks))
    check(
        "a quote wrapped across two comment lines is one clean span",
        "inner.spent = inner.spent.saturating_sub(1);" in wrapped_spans,
        f"the wrapped quote did not come back as one span: {sorted(wrapped_spans)}",
    )
    check(
        "no span carries the comment marker the reader stripped",
        not any("///" in span or "//!" in span for span in wrapped_spans),
        f"a span still holds its marker: {sorted(wrapped_spans)}. A registered "
        "literal can never match that, and the row reads as quoted by nobody",
    )
    SPLIT = (
        "    /// one `alpha\n"
        "    fn code() {}\n"
        "    /// two beta` gamma\n"
    )
    split_blocks = reader["comment_blocks"](SPLIT)
    check(
        "a comment block ends at a line of code",
        len(split_blocks) == 2
        and not set().union(*(reader["spans"](b) for b in split_blocks)),
        f"expected two blocks and no span; got {len(split_blocks)} blocks and "
        f"{sorted(set().union(*(reader['spans'](b) for b in split_blocks)))}. Joining "
        "a whole file's comment lines lets an unclosed backtick pair with one in "
        "another function and invent a span no comment contains",
    )

# ── `markers_for` HAD NO SELF-TEST COVERAGE AT ALL, and it decides every read ───
#
# The reader cases above lift `comment_blocks` and `spans` and exercise them on synthetic
# text. `markers_for` chooses WHICH markers those get, and it was neither lifted nor
# called here — so the whole per-file policy rested on the task's own probes. Those probes
# are real coverage and they run in the gate, but they check the two arms the task needs
# TODAY; the table below pins the policy itself, including the arms no walked file uses.
if "markers_for" in reader:
    mf = reader["markers_for"]
    RUST, HASH = tuple(reader["MARKERS"]), tuple(reader["HASH_MARKERS"])
    CASES = (
        # path,                     first bytes,            expected,  why
        ("keylink/src/rpc.rs",      "//! docs",             RUST, "Rust by suffix"),
        ("scripts/hook-guard.sh",   "#!/usr/bin/env bash",  HASH, "shell by suffix"),
        ("tools/helper.py",         "import os",            HASH, "python by suffix, no shebang"),
        (".githooks/pre-push",      "#!/usr/bin/env bash",  HASH, "suffix-less, by shebang"),
        (".githooks/pre-push.sample", "#!/bin/sh",          HASH, "SUFFIXED script, by shebang"),
        ("README.md",               "# A title",            RUST, "a `#` heading is NOT a shebang"),
        ("keylink/src/lib.rs",      "#![allow(unused)]",     RUST, "an inner ATTRIBUTE is not a shebang"),
    )
    wrong = [
        f"{path} -> {mf(path, text)} wanted {want} ({why})"
        for path, text, want, why in CASES
        if mf(path, text) != want
    ]
    check(
        "markers_for places every kind this task can meet",
        not wrong,
        "markers_for disagreed on: " + "; ".join(wrong) + ". The `.rs` arms are the "
        "dangerous ones: a Rust file read with `#` turns every attribute into a comment "
        "line, and a shell file read with `///` yields an EMPTY haystack that this task "
        "reports as a quote nobody wrote",
    )

print()
if failures:
    print(f"{len(failures)} self-test check(s) failed: {', '.join(failures)}",
          file=sys.stderr)
    sys.exit(1)
print("ok: the anchors gate reports each failure class as itself")
